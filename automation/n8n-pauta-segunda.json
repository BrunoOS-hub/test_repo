      ],
      "webhookId": "5a1f0c52-0b6e-4c1a-9d10-0000000000a7"
    },
    {
      "parameters": {
        "jsCode": "// Cada item que volta do loop é a resposta do Whapi. Sucesso = { sent: true }.\nconst items = $input.all();\nconst ok = (i) => i.json.sent === true && !i.json.error;\nconst falhas = items.filter((i) => !ok(i));\nreturn [{\n  json: {\n    total: items.length,\n    enviadas: items.length - falhas.length,\n    falhas: falhas.length,\n    erros: falhas.map((i) => (i.json.error && (i.json.error.message || i.json.error)) || JSON.stringify(i.json).slice(0, 200)),\n  },\n}];\n"
      },
