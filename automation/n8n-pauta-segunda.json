    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ok = (i) => i.json.sent === true;\nconst falhas = items.filter((i) => !ok(i));\nreturn [{ json: { total: items.length, enviadas: items.length - falhas.length, falhas: falhas.length, detalhes: falhas.map((i) => JSON.stringify(i.json).slice(0, 200)) } }];\n"
      },
