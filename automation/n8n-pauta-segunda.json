      "id": "9812aa87-f090-4b45-a6e9-c377f2fe0ea2",
      "name": "Buscar briefs.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "// Números e textos vêm prontos do motor (briefs.json). Aqui só cruzamos destinatário com texto.\nconst cfg = $('Config (telefones da demo)').first().json;\nconst data = $input.first().json;\nif (!Array.isArray(data.agents) || !Array.isArray(data.managers)) {\n  throw new Error('briefs.json em formato inesperado: faltam agents/managers.');\n}\nconst targets = [\n  { type: 'agent', name: cfg.agent_name, phone: String(cfg.agent_phone || '') },\n  { type: 'manager', name: cfg.manager_name, phone: String(cfg.manager_phone || '') },\n];\nconst out = [];\nfor (const t of targets) {\n  if (!/^\\d{10,15}$/.test(t.phone)) throw new Error(`Telefone inválido para ${t.name}: preencha o nó Config (só dígitos, 55 + DDD + número).`);\n  const list = t.type === 'manager' ? data.managers : data.agents;\n  const key = t.type === 'manager' ? 'manager' : 'agent';\n  const item = list.find((x) => x[key] === t.name);\n  if (!item) throw new Error(`\"${t.name}\" não existe no briefs.json. Disponíveis: ${list.map((x) => x[key]).join(', ')}`);\n  out.push({ json: { to: t.phone, body: t.type === 'manager' ? item.digest : item.brief, name: t.name, type: t.type, as_of: data.as_of } });\n}\nreturn out;\n"
      },
      "id": "8bd7cf71-b3ac-4f42-9049-94970fb2d576",
      "name": "Montar mensagens",
