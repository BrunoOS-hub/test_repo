      "id": "5a1f0c52-0b6e-4c1a-9d10-000000000003",
      "name": "Buscar briefs.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Destinatários da demo. Troque os telefones (só dígitos: 55 + DDD + número).\n// Os telefones ficam só aqui, dentro do n8n: nunca no repositório.\nconst DEMO_RECIPIENTS = [\n  { type: 'agent', name: 'Zane Levy', phone: '55XXXXXXXXXXX' },\n  { type: 'manager', name: 'Summer Sewald', phone: '55XXXXXXXXXXX' },\n];\n\nconst data = $input.first().json;\nif (!Array.isArray(data.agents) || !Array.isArray(data.managers)) {\n  throw new Error('briefs.json em formato inesperado: faltam \"agents\" ou \"managers\". Confira a URL do nó \"Buscar briefs.json\".');\n}\n\nconst out = [];\nfor (const r of DEMO_RECIPIENTS) {\n  if (r.type !== 'agent' && r.type !== 'manager') {\n    throw new Error(`Tipo inválido para ${r.name}: use 'agent' ou 'manager'.`);\n  }\n  if (!/^\\d{10,15}$/.test(r.phone)) {\n    throw new Error(`Telefone inválido para ${r.name}: troque o placeholder em DEMO_RECIPIENTS (só dígitos: 55 + DDD + número).`);\n  }\n  const isManager = r.type === 'manager';\n  const list = isManager ? data.managers : data.agents;\n  const key = isManager ? 'manager' : 'agent';\n  const item = list.find((x) => x[key] === r.name);\n  if (!item) {\n    throw new Error(`\"${r.name}\" (${r.type}) não existe no briefs.json. Disponíveis: ${list.map((x) => x[key]).join(', ')}`);\n  }\n  out.push({ json: { to: r.phone, body: isManager ? item.digest : item.brief, name: r.name, type: r.type } });\n}\nreturn out;\n"
      },
      "id": "5a1f0c52-0b6e-4c1a-9d10-000000000004",
      "name": "Destinatários",
      "type": "n8n-nodes-base.code",
